#!/usr/bin/env bash
# Starts the PlayVault UI. Used by the Steam library tile and the desktop entry.
# Before starting it installs a PlayVault update the backend has downloaded and verified
# (ROOT/update, see evault/updater.py), and rolls back to the previous version if an
# update fails to start twice.
HERE="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
APP="$(dirname "$HERE")"
ROOT="${PLAYVAULT_HOME:-$(dirname "$APP")}"
PORT="${PLAYVAULT_PORT:-47821}"
U="$ROOT/update"
mkdir -p "$ROOT/data/logs"

ulog() { echo "$(date '+%F %T') $*" >>"$ROOT/data/logs/update.log"; }

# Stops the backend so its files can be replaced. Fails if it's busy (download or game).
stop_backend() {
  local r
  r="$(curl -s -m 5 -X POST "http://127.0.0.1:$PORT/api/update/prepare" 2>/dev/null)"
  if [ -n "$r" ] && [[ "$r" != *'"ok": true'* ]]; then
    ulog "not now: $r"
    return 1
  fi
  systemctl --user stop playvault-backend 2>/dev/null
  for _ in $(seq 1 20); do
    curl -s -m 1 "http://127.0.0.1:$PORT/api/ping" >/dev/null 2>&1 || return 0
    sleep 0.25
  done
  return 0
}

restart_self() { cd "$APP" && exec "$APP/bin/playvault" "$@"; }

# ---------------------------------------------------------------- rollback
# trial.json exists until the new version's UI reports in (POST /api/update/confirm).
if [ -f "$U/trial.json" ] && [ -d "$ROOT/app.prev" ]; then
  tries=$(( $(cat "$U/trial.tries" 2>/dev/null || echo 0) + 1 ))
  if [ "$tries" -gt 2 ]; then
    if stop_backend; then
      ulog "update $(cat "$U/trial.json") did not start twice - rolling back"
      rm -rf "$U/failed-app"
      if mv "$APP" "$U/failed-app" && mv "$ROOT/app.prev" "$APP"; then
        mv "$U/trial.json" "$U/failed.json"
        rm -f "$U/trial.tries"
        restart_self "$@"
      fi
      ulog "rollback failed"
    fi
  else
    echo "$tries" >"$U/trial.tries"
  fi
fi

# ---------------------------------------------------------------- install a staged update
if [ -f "$U/ready.json" ] && [ -f "$U/app/bin/playvault" ] && [ ! -f "$U/trial.json" ]; then
  if stop_backend; then
    rm -rf "$ROOT/app.prev"
    if mv "$APP" "$ROOT/app.prev"; then
      if mv "$U/app" "$APP"; then
        mv "$U/ready.json" "$U/trial.json"
        rm -f "$U/trial.tries" "$U/failed.json"
        rm -rf "$U/failed-app"
        ulog "installed update $(cat "$U/trial.json")"
        restart_self "$@"
      fi
      mv "$ROOT/app.prev" "$APP"
    fi
    ulog "could not install the update (file move failed)"
  fi
fi

export PLAYVAULT_ROOT="$ROOT" PLAYVAULT_APP="$APP" PLAYVAULT_HOME="$ROOT"
exec "$ROOT/electron/electron" --no-sandbox --ozone-platform=x11 "$APP/electron" "$@" \
  >>"$ROOT/data/logs/electron.log" 2>&1
